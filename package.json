{
    "name": "rail-template",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sago-cream/create-rail.git"
    },
    "scripts": {
        "prepare": "husky",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "release": "release-it --config release-it.config.cjs",
        "smoke": "node scripts/smoke-create-rail.mjs",
        "test": "node --test scripts/test-create-rail.mjs",
        "check": "tsc -p tsconfig.json --noEmit && eslint . && node --check packages/create-rail/bin/create-rail.mjs && node --check scripts/smoke-create-rail.mjs && node --check scripts/sync-release-version.mjs && node --test scripts/test-create-rail.mjs && prettier . --check && vite build"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,css,scss,html,json,md,yml,yaml}": [
            "prettier --write"
        ],
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix"
        ]
    },
    "dependencies": {
        "lucide-react": "^1.61.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "complete-lint": "^5.27.1",
        "eslint": "^10.13.0",
        "eslint-config-complete": "^4.22.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "release-it": "^20.2.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.5"
    }
}
